{
  "name": "companygraph-io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "design": "design sync",
    "design:check": "design sync --check",
    "verify": "node verify/check.mjs",
    "pdf": "node export-pdf.mjs",
    "og": "node export-og.mjs",
    "og:check": "node og-check.mjs",
    "test:og": "node --test verify/og-recipe.test.mjs",
    "test:d3": "node --test verify/d3-vendoring.test.mjs",
    "example": "node build/build.mjs",
    "example:check": "node build/build.mjs --check"
  },
  "dependencies": {
    "d3": "7.9.0"
  },
  "devDependencies": {
    "@robertblust/design": "github:robertblust/design#v0.15.0",
    "companygraph-meta-model": "github:companygraph/meta-model#v0.5.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.49.1"
  }
}
