<?xml version="1.0" encoding="UTF-8"?>
<!--
  This file owns the talk URLs; nothing else in either repository names one. When the
  talks ship, companygraph.io/sitemap.xml is meant to become an index pointing at this
  file, so that list never carries a second copy of it to drift. That conversion is
  companygraph.github.io's to make and has not happened yet — if you find that file still
  flat and listing its own page directly, that is unfinished work, not a contradiction of
  this comment. Adding a talk here means adding it to README.md and to this file.

  No <lastmod>: without a build step it could only be hand-maintained, and a date that
  lies is worse than no date — crawlers discount a lastmod they catch being wrong.

  The PDFs are deliberately absent. They are the same talk in a second format — now in
  two languages — and a PDF that competes with the deck for the same query is a
  duplicate, not a page. The talks index links to them; the crawl map does not.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://companygraph.io/talks/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://companygraph.io/talks/intro/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
</urlset>
