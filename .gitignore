# What every member of the family ignores: installed packages, and the state an editor
# or a tool keeps beside the work.
node_modules
.vscode
.claudian
.superpowers

# package-lock.json is deliberately NOT ignored here (unlike the sibling repo):
# CI runs `npm ci`, which requires a committed lockfile to work at all.
__pycache__/
# A tool's local settings can hold a secret; conventions-sync keeps the lines below.
**/.claude/settings.local.json
